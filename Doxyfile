# Doxygen configuration for the Lely CANopen RT-Thread documentation site.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Lely CANopen RT-Thread"
PROJECT_BRIEF          = "RT-Thread integration package for Lely CANopen"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES

INPUT                  = README.md \
                         README.zh-CN.md \
                         docs \
                         port/rtthread \
                         examples/master_node1 \
                         examples/node1 \
                         upstream/include/lely

INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c \
                         *.h \
                         *.md
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
USE_MDFILE_AS_MAINPAGE = docs/doxygen-mainpage.md
RECURSIVE              = YES
EXCLUDE                = build \
                         .git \
                         .github
EXCLUDE_PATTERNS       = */.git/* \
                         */build/* \
                         */dist/*

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_BY_SCOPE_NAME     = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
SHOW_INCLUDE_FILES     = YES
SHOW_HEADERFILE        = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
HTML_DYNAMIC_MENUS     = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
GROUP_GRAPHS           = YES
DOT_NUM_THREADS        = 0

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
