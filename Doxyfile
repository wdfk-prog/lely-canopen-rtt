DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Lely CANopen RT-Thread"
PROJECT_BRIEF          = "Generated C/C++ API and source reference"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES

INPUT                  = docs/doxygen-mainpage.md \
                         port/rtthread \
                         examples/master_node1 \
                         examples/node1 \
                         upstream/include/lely
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cpp \
                         *.h \
                         *.hpp \
                         *.md
RECURSIVE              = YES
EXCLUDE                = build \
                         .git \
                         .github
EXCLUDE_PATTERNS       = */.git/* \
                         */build/* \
                         */devel/* \
                         */logs/* \
                         */dist/* \
                         */README.md

MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/doxygen-mainpage.md

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
SHOW_INCLUDE_FILES     = YES
SHOW_HEADERFILE        = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DIRECTORY_GRAPH        = YES
DOT_NUM_THREADS        = 0

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
